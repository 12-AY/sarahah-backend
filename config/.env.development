# App
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173

# Database
DB_URI=mongodb://127.0.0.1:27017/sarahah_dev

# Redis (sessions, OTP, TTL-based state) — swap for your Upstash rediss:// URL later
REDIS_URL=redis://127.0.0.1:6379

# Google OAuth — Client ID from Google Cloud Console (you'll add this)
GOOGLE_CLIENT_ID=

# JWT
ACCESS_TOKEN_SECRET=replace_with_strong_secret_access
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace_with_strong_secret_refresh
REFRESH_TOKEN_EXPIRES_IN=7d

# Bcrypt
SALT_ROUNDS=10

# OTP
OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Nodemailer (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="Sarahah Clone <no-reply@sarahah.top>"
