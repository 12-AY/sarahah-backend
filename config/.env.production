# App
PORT=3000
NODE_ENV=production
BASE_URL=https://api.sarahah.top
CLIENT_URL=https://sarahah.top

# Database
DB_URI=mongodb+srv://<user>:<password>@<cluster>/sarahah_prod

# Redis (Upstash) — e.g. rediss://default:<password>@<endpoint>.upstash.io:6379
REDIS_URL=

# Google OAuth — Client ID from Google Cloud Console
GOOGLE_CLIENT_ID=

# JWT
ACCESS_TOKEN_SECRET=replace_with_strong_secret_access
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace_with_strong_secret_refresh
REFRESH_TOKEN_EXPIRES_IN=7d

# Bcrypt
SALT_ROUNDS=12

# OTP
OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Nodemailer (SMTP)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sarahah Clone <no-reply@sarahah.top>"
